#include <WiFi.h>
#include <HTTPClient.h>
#include <max6675.h>
#include <WiFiClientSecure.h>
#include <time.h>
#include "mbedtls/md.h"

// ================= WIFI =================
#define WIFI_SSID     "G2.4"
#define WIFI_PASSWORD ""

// ================= SCRIPT =================
#define SCRIPT_URL "https://script.google.com/macros/s/AKfycbwfbBBiYX8Zja1W6BHC4lEwvNKXgq-bvKIUp_X2Ix2JB1eDEOAVtVT3enoVKnchQYQ66g/exec"
#define DEVICE_ID "oven_2"

// ================= SECURITY =================
String API_KEY = ""; //change for each oven
String SECRET  = ""; //keep the same

// ================= SERIAL =================
#define SERIAL_BAUD 9600

// ================= PINS =================
#define INDICATOR_PIN   2
#define SSR_PIN         4

#define THERMO_SCK_PIN  18
#define THERMO_CS_PIN    5
#define THERMO_SO_PIN   19

// ================= TIME =================
const char* NTP_SERVER_1 = "pool.ntp.org";
const char* NTP_SERVER_2 = "time.nist.gov";
const long GMT_OFFSET_SEC = 12 * 3600;
const int DAYLIGHT_OFFSET_SEC = 0;

// ================= OBJECTS =================
MAX6675 thermocouple(THERMO_SCK_PIN, THERMO_CS_PIN, THERMO_SO_PIN);
WiFiClientSecure secureClient;

// ================= PROFILE =================
struct Step {
  float temp;
  int duration;
};

Step profile[] = {
  {20, 30},
  {75, 1800},
  {75, 3600},
  {125, 1800},
  {125, 3600}
};

const int NUM_STEPS = sizeof(profile) / sizeof(profile[0]);

bool running = false;
unsigned long startTime = 0;
unsigned long lastControl = 0;
unsigned long lastUpload = 0;
unsigned long lastWiFiCheck = 0;

// ================= OUTPUT CONTROL =================
void setOutputs(bool state) {
  digitalWrite(INDICATOR_PIN, state);
  digitalWrite(SSR_PIN, state);
}

// ================= SECURITY HELPERS =================
String createHMAC(String message) {
  byte hmacResult[32];

  mbedtls_md_context_t ctx;
  mbedtls_md_type_t md_type = MBEDTLS_MD_SHA256;

  mbedtls_md_init(&ctx);
  mbedtls_md_setup(&ctx, mbedtls_md_info_from_type(md_type), 1);
  mbedtls_md_hmac_starts(&ctx, (const unsigned char*)SECRET.c_str(), SECRET.length());
  mbedtls_md_hmac_update(&ctx, (const unsigned char*)message.c_str(), message.length());
  mbedtls_md_hmac_finish(&ctx, hmacResult);
  mbedtls_md_free(&ctx);

  String hash = "";
  for (int i = 0; i < 32; i++) {
    if (hmacResult[i] < 16) hash += "0";
    hash += String(hmacResult[i], HEX);
  }
  hash.toLowerCase();
  return hash;
}

bool timeIsSynced() {
  time_t now = time(nullptr);
  return now > 1700000000;
}

long long getEpochMillis() {
  struct timeval tv;
  gettimeofday(&tv, nullptr);
  return ((long long)tv.tv_sec * 1000LL) + (tv.tv_usec / 1000);
}

void syncTime() {
  configTime(GMT_OFFSET_SEC, DAYLIGHT_OFFSET_SEC, NTP_SERVER_1, NTP_SERVER_2);

  Serial.print("SYNCING TIME");
  int tries = 0;
  while (!timeIsSynced() && tries < 30) {
    delay(500);
    Serial.print(".");
    tries++;
  }

  if (timeIsSynced()) {
    Serial.println("\n✅ TIME SYNCED");
  } else {
    Serial.println("\n❌ TIME SYNC FAILED");
  }
}

// ================= TARGET =================
float getTargetTemp(unsigned long t) {
  unsigned long elapsed = t / 1000;
  int cumulative = 0;

  for (int i = 0; i < NUM_STEPS; i++) {
    float startTemp = (i == 0) ? profile[0].temp : profile[i - 1].temp;
    float endTemp = profile[i].temp;

    if (elapsed < cumulative + profile[i].duration) {
      float progress = float(elapsed - cumulative) / profile[i].duration;
      return startTemp + progress * (endTemp - startTemp);
    }

    cumulative += profile[i].duration;
  }

  return profile[NUM_STEPS - 1].temp;
}

int getTotalTime() {
  int total = 0;
  for (int i = 0; i < NUM_STEPS; i++) total += profile[i].duration;
  return total;
}

// ================= SSR =================
void controlSSR(float currentTemp, float targetTemp) {
  float error = targetTemp - currentTemp;

  if (currentTemp >= targetTemp + 1.0) {
    setOutputs(false);
    Serial.println("SSR OFF (over +1C)");
    return;
  }

  float duty;

  if (error > 5.0) {
    duty = 1.0;
  }
  else if (error > 0) {
    duty = 0.2 + (error / 5.0) * 0.8;
  }
  else {
    duty = 0.2;
  }

  int onTime = duty * 1000;

  if (millis() % 1000 < onTime) {
    setOutputs(true);
    Serial.println("SSR ON");
  } else {
    setOutputs(false);
    Serial.println("SSR OFF (PWM)");
  }

  Serial.println("ERROR: " + String(error));
  Serial.println("DUTY: " + String(duty));
}

// ================= GOOGLE =================
void sendData(String csv, float temp, int timeLeft) {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("❌ WiFi not connected - skip send");
    return;
  }

  if (!timeIsSynced()) {
    Serial.println("❌ Time not synced - skip secure send");
    return;
  }

  HTTPClient http;

  long long ts = getEpochMillis();

  String tempStr = String(temp);
  String timeLeftStr = String(timeLeft);
  String payload = csv + tempStr + timeLeftStr + String(ts);
  String sig = createHMAC(payload);

  String url = String(SCRIPT_URL) +
    "?type=log" +
    "&device=" + String(DEVICE_ID) +
    "&csv=" + csv +
    "&temp=" + tempStr +
    "&timeleft=" + timeLeftStr +
    "&key=" + API_KEY +
    "&ts=" + String(ts) +
    "&sig=" + sig;

  Serial.println("📤 SENDING:");
  Serial.println(url);

  secureClient.setInsecure();
  http.begin(secureClient, url);
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  http.setTimeout(5000);

  int code = http.GET();

  Serial.println("HTTP CODE: " + String(code));

  if (code > 0) {
    String payloadResponse = http.getString();
    Serial.println("RESPONSE: " + payloadResponse);
  } else {
    Serial.println("❌ HTTP FAILED");
  }

  http.end();
}

String getCommand() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("❌ WiFi not connected - cannot get command");
    return "";
  }

  HTTPClient http;

  String url = String(SCRIPT_URL) +
    "?type=control" +
    "&device=" + String(DEVICE_ID) +
    "&key=" + API_KEY +
    "&t=" + String(millis());

  Serial.println("📥 GET CMD:");
  Serial.println(url);

  secureClient.setInsecure();
  http.begin(secureClient, url);
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  http.setTimeout(5000);

  int code = http.GET();

  Serial.println("CMD HTTP CODE: " + String(code));

  if (code > 0) {
    String payload = http.getString();
    payload.trim();

    Serial.println("CMD RECEIVED: [" + payload + "]");

    http.end();
    return payload;
  }

  Serial.println("❌ FAILED TO GET COMMAND");
  http.end();
  return "";
}

// ================= SETUP =================
void setup() {
  Serial.begin(SERIAL_BAUD);

  pinMode(INDICATOR_PIN, OUTPUT);
  pinMode(SSR_PIN, OUTPUT);

  setOutputs(false);

  Serial.println("BOOTING...");

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  Serial.print("CONNECTING");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\n✅ WIFI CONNECTED");
  Serial.println(WiFi.localIP());

  syncTime();
}

// ================= LOOP =================
void loop() {
  // ===== WIFI KEEP ALIVE =====
  if (millis() - lastWiFiCheck > 10000) {
    lastWiFiCheck = millis();

    if (WiFi.status() != WL_CONNECTED) {
      Serial.println("⚠️ WiFi lost - reconnecting...");
      WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
    }

    if (!timeIsSynced()) {
      syncTime();
    }
  }

  // ===== GET COMMAND =====
  static bool runLocked = false;
  static String lastCmd = "";

  String cmd = getCommand();

  bool newCommand = (cmd != lastCmd);
  lastCmd = cmd;

  if (cmd == "RUN" && !running && !runLocked && newCommand) {
    running = true;
    startTime = millis();
    Serial.println("🔥 RUN STARTED");
  }
  else if (cmd == "STOP" && newCommand) {
    running = false;
    runLocked = false;
    setOutputs(false);
    Serial.println("🛑 STOPPED (UNLOCKED)");
  }
  else {
    Serial.println("CMD: " + cmd);
  }

  // ===== CONTROL LOOP =====
  if (running && millis() - lastControl >= 1000) {
    lastControl = millis();

    unsigned long t = millis() - startTime;
    int totalTime = getTotalTime();

    float currentTemp = thermocouple.readCelsius();
    float targetTemp = getTargetTemp(t);

    Serial.println("---- CONTROL ----");
    Serial.println("TIME: " + String(t / 1000));
    Serial.println("CURRENT: " + String(currentTemp));
    Serial.println("TARGET: " + String(targetTemp));

    if (t / 1000 >= totalTime) {
      running = false;
      runLocked = true;
      setOutputs(false);
      Serial.println("✅ PROFILE COMPLETE (LOCKED)");
      return;
    }

    controlSSR(currentTemp, targetTemp);
  }

  // ===== SEND DATA =====
  if (millis() - lastUpload >= 20000) {
    lastUpload = millis();

    float currentTemp = thermocouple.readCelsius();

    int timeLeft = 0;
    float targetTemp = currentTemp;
    String csv = "";

    if (running) {
      unsigned long t = millis() - startTime;
      int totalTime = getTotalTime();

      targetTemp = getTargetTemp(t);
      timeLeft = totalTime - (t / 1000);

      csv = String((int)(t / 1000)) + "," +
            String(currentTemp) + "," +
            String(targetTemp);
    }

    Serial.println("---- UPLOAD ----");
    Serial.println("TEMP: " + String(currentTemp));
    Serial.println("TIME LEFT: " + String(timeLeft));
    Serial.println("CSV: " + csv);

    sendData(csv, currentTemp, timeLeft);
  }
}
