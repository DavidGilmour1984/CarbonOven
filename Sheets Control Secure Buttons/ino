// ================= PROFILE STRUCTURE =================
struct Step {
  float temp;
  int duration;
  char stageName[64];  // Stage name
};

struct DutyCycleBand {
  float tempDelta;  // Temperature difference from target (e.g., -6, -4, -2, 0, 1, 2)
  float dutyCycle;  // Duty cycle percentage (e.g., 100, 80, 40, 20, 10, 0)
};

Step profile[8];  // Max 8 steps
DutyCycleBand dutyCycleBands[12];  // Max 12 bands (T1-T6 pairs)

int NUM_STEPS = 0;
int NUM_DC_BANDS = 0;

// Current stage tracking
int currentStepIndex = 0;
String currentStageName = "";
 
bool running = false;
unsigned long startTime = 0;
unsigned long lastControl = 0;
unsigned long lastUpload = 0;
unsigned long lastWiFiCheck = 0;
 
// ================= BUTTON DEBOUNCING =================
#define DEBOUNCE_DELAY 50
unsigned long lastRunButtonTime = 0;
unsigned long lastStopButtonTime = 0;
bool lastRunButtonState = HIGH;
bool lastStopButtonState = HIGH;
 
bool runLocked = false;
String lastRemoteCmd = "";
bool wifiConnected = false;

// ================= SPIFFS / FLASH STORAGE =================
#define CONFIG_FILE "/config.json"

void initSPIFFS() {
  if (!SPIFFS.begin(true)) {
    Serial.println("❌ SPIFFS Mount Failed");
    return;
  }
  Serial.println("✅ SPIFFS Mounted");
}

void saveConfigToFlash() {
  DynamicJsonDocument doc(4096);
  
  JsonArray stepsArray = doc.createNestedArray("profile");
  for (int i = 0; i < NUM_STEPS; i++) {
    JsonObject step = stepsArray.createNestedObject();
    step["temp"] = profile[i].temp;
    step["duration"] = profile[i].duration;
    step["stageName"] = profile[i].stageName;
  }
  
  JsonArray bandsArray = doc.createNestedArray("dutyCycles");
  for (int i = 0; i < NUM_DC_BANDS; i++) {
    JsonObject band = bandsArray.createNestedObject();
    band["tempDelta"] = dutyCycleBands[i].tempDelta;
    band["dutyCycle"] = dutyCycleBands[i].dutyCycle;
  }
  
  File configFile = SPIFFS.open(CONFIG_FILE, "w");
  if (!configFile) {
    Serial.println("❌ Failed to open config file for writing");
    return;
  }
  
  serializeJson(doc, configFile);
  configFile.close();
  
  Serial.println("✅ Config saved to flash");
}

bool loadConfigFromFlash() {
  if (!SPIFFS.exists(CONFIG_FILE)) {
    Serial.println("⚠️ Config file not found on flash");
    return false;
  }
  
  File configFile = SPIFFS.open(CONFIG_FILE, "r");
  if (!configFile) {
    Serial.println("❌ Failed to open config file");
    return false;
  }
  
  DynamicJsonDocument doc(4096);
  DeserializationError error = deserializeJson(doc, configFile);
  configFile.close();
  
  if (error) {
    Serial.println("❌ Failed to parse config JSON");
    return false;
  }
  
  // Load profile
  JsonArray stepsArray = doc["profile"];
  NUM_STEPS = stepsArray.size();
  if (NUM_STEPS > 8) NUM_STEPS = 8;
  
  for (int i = 0; i < NUM_STEPS; i++) {
    profile[i].temp = stepsArray[i]["temp"];
    profile[i].duration = stepsArray[i]["duration"];
    strncpy(profile[i].stageName, stepsArray[i]["stageName"].as<const char*>(), 63);
    profile[i].stageName[63] = '\0';
  }
  
  // Load duty cycles
  JsonArray bandsArray = doc["dutyCycles"];
  NUM_DC_BANDS = bandsArray.size();
  if (NUM_DC_BANDS > 12) NUM_DC_BANDS = 12;
  
  for (int i = 0; i < NUM_DC_BANDS; i++) {
    dutyCycleBands[i].tempDelta = bandsArray[i]["tempDelta"];
    dutyCycleBands[i].dutyCycle = bandsArray[i]["dutyCycle"];
  }
  
  Serial.println("✅ Config loaded from flash");
  Serial.println("   Loaded " + String(NUM_STEPS) + " profile steps");
  Serial.println("   Loaded " + String(NUM_DC_BANDS) + " duty cycle bands");
  
  return true;
}

void printConfig() {
  Serial.println("\n===== CURRENT CONFIG =====");
  Serial.println("PROFILE STEPS:");
  for (int i = 0; i < NUM_STEPS; i++) {
    Serial.println("  Step " + String(i) + ": " + String(profile[i].temp) + "°C for " + 
                   String(profile[i].duration) + "s [" + String(profile[i].stageName) + "]");
  }
  
  Serial.println("DUTY CYCLE BANDS:");
  for (int i = 0; i < NUM_DC_BANDS; i++) {
    Serial.println("  Band " + String(i) + ": ΔT=" + String(dutyCycleBands[i].tempDelta) + 
                   "°C → DC=" + String(dutyCycleBands[i].dutyCycle) + "%");
  }
  Serial.println("==========================\n");
}
 
// ================= OUTPUT CONTROL =================
void setOutputs(bool state) {
  digitalWrite(INDICATOR_PIN, state);
  digitalWrite(SSR_PIN, state);
}
 
// ================= BUTTON DEBOUNCING LOGIC =================
bool readButton(int pin, unsigned long &lastTime, bool &lastState) {
  bool currentState = digitalRead(pin);
  
  if (currentState != lastState) {
    lastTime = millis();
    lastState = currentState;
    return false;
  }
  
  if ((millis() - lastTime) > DEBOUNCE_DELAY) {
    return currentState == LOW; // Returns true if button is pressed (LOW)
  }
  
  return false;
}
 
// ================= SECURITY HELPERS =================
String createHMAC(String message) {
  byte hmacResult[32];
 
  mbedtls_md_context_t ctx;
  mbedtls_md_type_t md_type = MBEDTLS_MD_SHA256;
 
  mbedtls_md_init(&ctx);
  mbedtls_md_setup(&ctx, mbedtls_md_info_from_type(md_type), 1);
  mbedtls_md_hmac_starts(&ctx, (const unsigned char*)SECRET.c_str(), SECRET.length());
  mbedtls_md_hmac_update(&ctx, (const unsigned char*)message.c_str(), message.length());
  mbedtls_md_hmac_finish(&ctx, hmacResult);
  mbedtls_md_free(&ctx);
 
  String hash = "";
  for (int i = 0; i < 32; i++) {
    if (hmacResult[i] < 16) hash += "0";
    hash += String(hmacResult[i], HEX);
  }
  hash.toLowerCase();
  return hash;
}
 
bool timeIsSynced() {
  time_t now = time(nullptr);
  return now > 1700000000;
}
 
long long getEpochMillis() {
  struct timeval tv;
  gettimeofday(&tv, nullptr);
  return ((long long)tv.tv_sec * 1000LL) + (tv.tv_usec / 1000);
}
 
void syncTime() {
  configTime(GMT_OFFSET_SEC, DAYLIGHT_OFFSET_SEC, NTP_SERVER_1, NTP_SERVER_2);
 
  Serial.print("SYNCING TIME");
  int tries = 0;
  while (!timeIsSynced() && tries < 30) {
    delay(500);
    Serial.print(".");
    tries++;
  }
 
  if (timeIsSynced()) {
    Serial.println("\n✅ TIME SYNCED");
  } else {
    Serial.println("\n❌ TIME SYNC FAILED");
  }
}
 
// ================= TARGET =================
float getTargetTemp(unsigned long t) {
  unsigned long elapsed = t / 1000;
  int cumulative = 0;
 
  for (int i = 0; i < NUM_STEPS; i++) {
    float startTemp = (i == 0) ? profile[0].temp : profile[i - 1].temp;
    float endTemp = profile[i].temp;
 
    if (elapsed < cumulative + profile[i].duration) {
      currentStepIndex = i;
      currentStageName = String(profile[i].stageName);
      float progress = float(elapsed - cumulative) / profile[i].duration;
      return startTemp + progress * (endTemp - startTemp);
    }
 
    cumulative += profile[i].duration;
  }
 
  currentStepIndex = NUM_STEPS - 1;
  currentStageName = String(profile[NUM_STEPS - 1].stageName);
  return profile[NUM_STEPS - 1].temp;
}
 
int getTotalTime() {
  int total = 0;
  for (int i = 0; i < NUM_STEPS; i++) total += profile[i].duration;
  return total;
}

// ================= DUTY CYCLE LOOKUP =================
float getDutyCycle(float currentTemp, float targetTemp) {
  float error = targetTemp - currentTemp;
  
  // Find the appropriate duty cycle band
  // Bands should be sorted by tempDelta (descending, from most positive to most negative)
  for (int i = 0; i < NUM_DC_BANDS; i++) {
    if (error >= dutyCycleBands[i].tempDelta) {
      return dutyCycleBands[i].dutyCycle / 100.0; // Convert % to decimal
    }
  }
  
  // If no match, use last band (fallback)
  return (NUM_DC_BANDS > 0) ? dutyCycleBands[NUM_DC_BANDS - 1].dutyCycle / 100.0 : 0.2;
}
 
// ================= SSR =================
void controlSSR(float currentTemp, float targetTemp) {
  float error = targetTemp - currentTemp;
  
  // Check if over temperature
  if (currentTemp >= targetTemp + 1.0) {
    setOutputs(false);
    Serial.println("SSR OFF (over +1C)");
    return;
  }
  
  float duty = getDutyCycle(currentTemp, targetTemp);
  int onTime = duty * 1000;
 
  if (millis() % 1000 < onTime) {
    setOutputs(true);
    Serial.println("SSR ON");
  } else {
    setOutputs(false);
    Serial.println("SSR OFF (PWM)");
  }
 
  Serial.println("ERROR: " + String(error));
  Serial.println("DUTY: " + String(duty));
}
 
// ================= FETCH SETTINGS FROM GOOGLE SHEET =================
bool fetchSettingsFromGoogle() {
  if (!wifiConnected) {
    Serial.println("⚠️ WiFi not connected - cannot fetch settings");
    return false;
  }
  
  if (!timeIsSynced()) {
    Serial.println("⚠️ Time not synced - cannot fetch settings securely");
    return false;
  }
  
  HTTPClient http;
  
  String url = String(SCRIPT_URL) +
    "?type=settings" +
    "&device=" + String(DEVICE_ID) +
    "&key=" + API_KEY;
  
  Serial.println("📥 FETCHING SETTINGS FROM GOOGLE:");
  Serial.println(url);
  
  secureClient.setInsecure();
  http.begin(secureClient, url);
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  http.setTimeout(10000);
  
  int code = http.GET();
  
  Serial.println("SETTINGS HTTP CODE: " + String(code));
  
  if (code != 200) {
    Serial.println("❌ FAILED TO FETCH SETTINGS");
    http.end();
    return false;
  }
  
  String payload = http.getString();
  http.end();
  
  Serial.println("SETTINGS PAYLOAD: " + payload);
  
  // Parse JSON response
  DynamicJsonDocument doc(4096);
  DeserializationError error = deserializeJson(doc, payload);
  
  if (error) {
    Serial.println("❌ Failed to parse settings JSON: " + String(error.c_str()));
    return false;
  }
  
  // Load profile
  JsonArray stepsArray = doc["profile"];
  NUM_STEPS = stepsArray.size();
  if (NUM_STEPS > 8) NUM_STEPS = 8;
  
  for (int i = 0; i < NUM_STEPS; i++) {
    profile[i].temp = stepsArray[i]["temp"];
    profile[i].duration = stepsArray[i]["duration"];
    strncpy(profile[i].stageName, stepsArray[i]["stageName"].as<const char*>(), 63);
    profile[i].stageName[63] = '\0';
  }
  
  // Load duty cycles
  JsonArray bandsArray = doc["dutyCycles"];
  NUM_DC_BANDS = bandsArray.size();
  if (NUM_DC_BANDS > 12) NUM_DC_BANDS = 12;
  
  for (int i = 0; i < NUM_DC_BANDS; i++) {
    dutyCycleBands[i].tempDelta = bandsArray[i]["tempDelta"];
    dutyCycleBands[i].dutyCycle = bandsArray[i]["dutyCycle"];
  }
  
  Serial.println("✅ SETTINGS FETCHED AND LOADED");
  saveConfigToFlash();
  printConfig();
  
  return true;
}
 
