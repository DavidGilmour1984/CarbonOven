// ================= GOOGLE =================
// URL-encode a string (convert spaces to %20, etc.)
String urlEncode(String str) {
  String encoded = "";
  for (int i = 0; i < str.length(); i++) {
    char c = str.charAt(i);
    if (c == ' ') {
      encoded += "%20";
    } else if (c == '&') {
      encoded += "%26";
    } else if (c == '=') {
      encoded += "%3D";
    } else if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || 
               (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~') {
      encoded += c;
    } else {
      // For other characters, convert to hex
      encoded += "%";
      if (c < 16) encoded += "0";
      encoded += String(c, HEX);
    }
  }
  return encoded;
}

void sendData(String csv, float temp, int timeLeft) {
  if (!wifiConnected) {
    Serial.println("❌ WiFi not connected - skip send");
    return;
  }
 
  if (!timeIsSynced()) {
    Serial.println("❌ Time not synced - skip secure send");
    return;
  }
 
  HTTPClient http;
 
  long long ts = getEpochMillis();
 
  String tempStr = String(temp);
  String timeLeftStr = String(timeLeft);
  String stageNameStr = urlEncode(currentStageName);  // URL-encode stage name
  
  String payload = csv + tempStr + timeLeftStr + String(ts);
  String sig = createHMAC(payload);
 
  String url = String(SCRIPT_URL) +
    "?type=log" +
    "&device=" + String(DEVICE_ID) +
    "&csv=" + csv +
    "&temp=" + tempStr +
    "&timeleft=" + timeLeftStr +
    "&stageName=" + stageNameStr +
    "&key=" + API_KEY +
    "&ts=" + String(ts) +
    "&sig=" + sig;
 
  Serial.println("📤 SENDING:");
  Serial.println(url);
 
  secureClient.setInsecure();
  http.begin(secureClient, url);
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  http.setTimeout(5000);
 
  int code = http.GET();
 
  Serial.println("HTTP CODE: " + String(code));
 
  if (code > 0) {
    String payloadResponse = http.getString();
    Serial.println("RESPONSE: " + payloadResponse);
  } else {
    Serial.println("❌ HTTP FAILED");
  }
 
  http.end();
}
 
String getCommand() {
  if (!wifiConnected) {
    Serial.println("⚠️ WiFi not connected - cannot get command");
    return "";
  }
 
  HTTPClient http;
 
  String url = String(SCRIPT_URL) +
    "?type=control" +
    "&device=" + String(DEVICE_ID) +
    "&key=" + API_KEY +
    "&t=" + String(millis());
 
  Serial.println("📥 GET CMD:");
  Serial.println(url);
 
  secureClient.setInsecure();
  http.begin(secureClient, url);
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  http.setTimeout(5000);
 
  int code = http.GET();
 
  Serial.println("CMD HTTP CODE: " + String(code));
 
  if (code > 0) {
    String payload = http.getString();
    payload.trim();
 
    Serial.println("CMD RECEIVED: [" + payload + "]");
 
    http.end();
    return payload;
  }
 
  Serial.println("❌ FAILED TO GET COMMAND");
  http.end();
  return "";
}
 
// ================= SETUP =================
void setup() {
  Serial.begin(SERIAL_BAUD);
 
  pinMode(INDICATOR_PIN, OUTPUT);
  pinMode(SSR_PIN, OUTPUT);
  pinMode(RUN_BUTTON_PIN, INPUT_PULLUP);
  pinMode(STOP_BUTTON_PIN, INPUT_PULLUP);
 
  setOutputs(false);
 
  Serial.println("\n\n==================");
  Serial.println("BOOTING...");
  Serial.println("==================");
  Serial.println("RUN BUTTON:  D16");
  Serial.println("STOP BUTTON: D17");
  Serial.println("==================");
  
  // Initialize SPIFFS
  initSPIFFS();
  
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
 
  Serial.print("CONNECTING TO WIFI");
  int wifiAttempts = 0;
  while (WiFi.status() != WL_CONNECTED && wifiAttempts < 20) {
    delay(500);
    Serial.print(".");
    wifiAttempts++;
  }
 
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\n✅ WIFI CONNECTED");
    Serial.println(WiFi.localIP());
    wifiConnected = true;
    syncTime();
    
    // Fetch settings from Google Sheet
    if (fetchSettingsFromGoogle()) {
      Serial.println("✅ Using settings from Google Sheet");
    } else {
      Serial.println("⚠️ Failed to fetch settings from Google, trying local flash...");
      if (loadConfigFromFlash()) {
        Serial.println("✅ Using cached settings from flash");
      } else {
        Serial.println("❌ No cached settings available - using defaults");
        // You could set hardcoded defaults here if needed
      }
    }
  } else {
    Serial.println("\n⚠️ WIFI NOT CONNECTED - RUNNING IN OFFLINE MODE");
    wifiConnected = false;
    
    // Try to load cached settings from flash
    if (loadConfigFromFlash()) {
      Serial.println("✅ Using cached settings from flash");
    } else {
      Serial.println("❌ No cached settings available");
    }
  }
  
  printConfig();
}
 
// ================= LOOP =================
void loop() {
  // ===== WIFI KEEP ALIVE =====
  if (millis() - lastWiFiCheck > 10000) {
    lastWiFiCheck = millis();
 
    if (WiFi.status() != WL_CONNECTED) {
      wifiConnected = false;
      Serial.println("⚠️ WiFi lost - attempting to reconnect...");
      WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
    } else {
      wifiConnected = true;
      if (!timeIsSynced()) {
        syncTime();
      }
    }
  }
 
  // ===== LOCAL BUTTON CONTROL =====
  if (readButton(RUN_BUTTON_PIN, lastRunButtonTime, lastRunButtonState)) {
    Serial.println("🔘 RUN BUTTON PRESSED (LOCAL)");
    if (!running && !runLocked) {
      running = true;
      startTime = millis();
      Serial.println("🔥 RUN STARTED (LOCAL BUTTON)");
      // Notify Google Sheet of RUN command
      if (wifiConnected) {
        sendButtonEvent("RUN");
      }
    } else if (runLocked) {
      Serial.println("⚠️ RUN LOCKED - profile already completed");
    }
  }
 
  if (readButton(STOP_BUTTON_PIN, lastStopButtonTime, lastStopButtonState)) {
    Serial.println("🔘 STOP BUTTON PRESSED (LOCAL)");
    running = false;
    runLocked = false;
    setOutputs(false);
    Serial.println("🛑 STOPPED (LOCAL BUTTON - UNLOCKED)");
    // Notify Google Sheet of STOP command
    if (wifiConnected) {
      sendButtonEvent("STOP");
    }
  }
 
  // ===== GET REMOTE COMMAND (if WiFi connected) =====
  if (wifiConnected && millis() % 10000 < 100) { // Check every ~10 seconds
    String cmd = getCommand();
 
    bool newCommand = (cmd != lastRemoteCmd);
    lastRemoteCmd = cmd;
 
    if (cmd == "RUN") {
      if (!running && !runLocked && newCommand) {
        // Start new run
        running = true;
        startTime = millis();
        Serial.println("🔥 RUN STARTED (REMOTE COMMAND)");
      }
      else if (newCommand) {
        Serial.println("CMD: RUN (already running or locked)");
      }
    }
    else if (cmd == "STOP") {
      if (running || newCommand) {
        // Stop immediately if running, or acknowledge STOP command
        running = false;
        runLocked = false;
        setOutputs(false);
        Serial.println("🛑 STOPPED (REMOTE COMMAND - UNLOCKED)");
      }
    }
    else if (cmd != "") {
      Serial.println("CMD: " + cmd);
    }
  }
 
  // ===== CONTROL LOOP =====
  if (running && millis() - lastControl >= 1000) {
    lastControl = millis();
 
    unsigned long t = millis() - startTime;
    int totalTime = getTotalTime();
 
    float currentTemp = thermocouple.readCelsius();
    float targetTemp = getTargetTemp(t);
 
    Serial.println("---- CONTROL ----");
    Serial.println("TIME: " + String(t / 1000));
    Serial.println("CURRENT: " + String(currentTemp));
    Serial.println("TARGET: " + String(targetTemp));
 
    if (t / 1000 >= totalTime) {
      running = false;
      runLocked = true;
      setOutputs(false);
      Serial.println("✅ PROFILE COMPLETE (LOCKED)");
      return;
    }
 
    controlSSR(currentTemp, targetTemp);
  }
 
  // ===== SEND DATA (only if WiFi connected) =====
  if (wifiConnected && millis() - lastUpload >= 20000) {
    lastUpload = millis();
 
    float currentTemp = thermocouple.readCelsius();
 
    int timeLeft = 0;
    float targetTemp = currentTemp;
    String csv = "";
 
    if (running) {
      unsigned long t = millis() - startTime;
      int totalTime = getTotalTime();
 
      targetTemp = getTargetTemp(t);
      timeLeft = totalTime - (t / 1000);
 
      csv = String((int)(t / 1000)) + "," +
            String(currentTemp) + "," +
            String(targetTemp);
    }
 
    Serial.println("---- UPLOAD ----");
    Serial.println("TEMP: " + String(currentTemp));
    Serial.println("TIME LEFT: " + String(timeLeft));
    Serial.println("CSV: " + csv);
 
    sendData(csv, currentTemp, timeLeft);
  }
}
