#include <Arduino.h>
#include <max6675.h>
#include <Preferences.h>

// ================= PINS =================
#define CLK_PIN 18
#define CS_PIN  5
#define DO_PIN  19
#define SSR_PIN 4

// ================= MAX6675 =================
MAX6675 thermocouple(CLK_PIN, CS_PIN, DO_PIN);

// ================= FLASH =================
Preferences prefs;

// ================= SERIAL =================
#define SERIAL_BAUD 115200

// ================= PROFILE =================
const int MAX_POINTS = 32;
const int MAX_PROFILES = 10;
const int PROFILE_NAME_LEN = 32;

struct ProfilePoint {
  float timeSec;
  float tempC;
};

struct StoredProfile {
  char name[PROFILE_NAME_LEN];
  int pointCount;
  ProfilePoint points[MAX_POINTS];
};

// Current working profile in RAM
StoredProfile currentProfile;
bool profileLoaded = false;

// ================= CONTROL SETTINGS =================
struct ControlSettings {
  float pidBandC;        // Temperature band for proportional control
  float minDutyPercent;  // Minimum duty cycle when heating
  float controlWindowSec; // PWM window duration
};

ControlSettings ctrlSettings;

// ================= RUNTIME =================
bool runActive = false;
unsigned long runStartMs = 0;
unsigned long lastTempReadMs = 0;
unsigned long lastTelemetryMs = 0;
unsigned long windowStartMs = 0;
bool pendingSave = false;
unsigned long saveTriggerTime = 0;
float currentTempC = 0.0f;
float targetTempC = 0.0f;
float currentDutyPercent = 0.0f;
bool ssrState = false;

// ================= LINE BUFFER =================
String rxLine = "";

// =====================================================
// ================= FLASH FUNCTIONS ====================
// =====================================================

void initFlashStorage() {
  prefs.begin("curing", false);
  
  // Initialize settings if they don't exist
  if (!prefs.isKey("pidBand")) {
    prefs.putFloat("pidBand", 5.0f);
    prefs.putFloat("minDuty", 20.0f);
    prefs.putFloat("ctrlWindow", 2.0f);
  }
  
  prefs.end();
  
  loadSettingsFromFlash();
}

void loadSettingsFromFlash() {
  prefs.begin("curing", true);
  
  ctrlSettings.pidBandC = prefs.getFloat("pidBand", 5.0f);
  ctrlSettings.minDutyPercent = prefs.getFloat("minDuty", 20.0f);
  ctrlSettings.controlWindowSec = prefs.getFloat("ctrlWindow", 2.0f);
  
  prefs.end();
}

void saveSettingsToFlash() {
  prefs.begin("curing", false);
  
  prefs.putFloat("pidBand", ctrlSettings.pidBandC);
  prefs.putFloat("minDuty", ctrlSettings.minDutyPercent);
  prefs.putFloat("ctrlWindow", ctrlSettings.controlWindowSec);
  
  prefs.end();
}

void listProfilesInFlash() {
  prefs.begin("profiles", true);

  int count = prefs.getInt("count", 0);

  Serial.print("PROFILES,");
  Serial.print(count);

  for (int i = 0; i < count; i++) {
    String nameKey = "name" + String(i);
    String countKey = "cnt" + String(i);
    
    String name = prefs.getString(nameKey.c_str(), "");
    int pts = prefs.getInt(countKey.c_str(), 0);

    Serial.print(",");
    Serial.print(i);
    Serial.print(",");
    Serial.print(name);
    Serial.print(",");
    Serial.print(pts);
  }

  Serial.println();
  prefs.end();
}

void saveCurrentProfileToFlash(int slotIndex) {
  if (slotIndex < 0 || slotIndex >= MAX_PROFILES) {
    Serial.println("ERROR,invalid_slot");
    return;
  }

  prefs.begin("profiles", false);
  
  // Get current count
  int count = prefs.getInt("count", 0);
  
  // Update slot
  String nameKey = "name" + String(slotIndex);
  String countKey = "cnt" + String(slotIndex);
  
  prefs.putString(nameKey.c_str(), currentProfile.name);
  prefs.putInt(countKey.c_str(), currentProfile.pointCount);
  
  // Save points
  for (int i = 0; i < currentProfile.pointCount; i++) {
    String tKey = "t" + String(slotIndex) + "_" + String(i);
    String yKey = "y" + String(slotIndex) + "_" + String(i);
    
    prefs.putFloat(tKey.c_str(), currentProfile.points[i].timeSec);
    prefs.putFloat(yKey.c_str(), currentProfile.points[i].tempC);
  }
  
  // Update count if this is a new slot
  if (slotIndex >= count) {
    prefs.putInt("count", slotIndex + 1);
  }
  
  prefs.end();
  
  Serial.print("SAVED,");
Serial.print(slotIndex);
Serial.print(",");
Serial.println(currentProfile.name);

}

void loadProfileFromFlash(int slotIndex) {
  if (slotIndex < 0 || slotIndex >= MAX_PROFILES) {
    Serial.println("ERROR,invalid_slot");
    return;
  }

  prefs.begin("profiles", true);
  
  String nameKey = "name" + String(slotIndex);
  String countKey = "cnt" + String(slotIndex);
  
  String name = prefs.getString(nameKey.c_str(), "");
  int pointCount = prefs.getInt(countKey.c_str(), 0);
  
  if (pointCount <= 0 || pointCount > MAX_POINTS) {
    prefs.end();
    Serial.println("ERROR,slot_empty");
    return;
  }
  
  // Copy name
  name.toCharArray(currentProfile.name, PROFILE_NAME_LEN);
  currentProfile.pointCount = pointCount;
  
  // Load points
  for (int i = 0; i < pointCount; i++) {
    String tKey = "t" + String(slotIndex) + "_" + String(i);
    String yKey = "y" + String(slotIndex) + "_" + String(i);
    
    currentProfile.points[i].timeSec = prefs.getFloat(tKey.c_str(), 0.0f);
    currentProfile.points[i].tempC = prefs.getFloat(yKey.c_str(), 0.0f);
  }
  
  prefs.end();
  
  // Save this slot as last used
  prefs.begin("curing", false);
  prefs.putInt("lastSlot", slotIndex);
  prefs.end();
  
  profileLoaded = true;
  
  Serial.print("LOADED,");
Serial.print(currentProfile.name);
Serial.print(",");
Serial.println(currentProfile.pointCount);

sendCurrentProfile();

}

void deleteProfileFromFlash(int slotIndex) {
  if (slotIndex < 0 || slotIndex >= MAX_PROFILES) {
    Serial.println("ERROR,invalid_slot");
    return;
  }

  prefs.begin("profiles", false);
  
  String nameKey = "name" + String(slotIndex);
  String countKey = "cnt" + String(slotIndex);
  
  // Delete the name and count
  prefs.remove(nameKey.c_str());
  prefs.remove(countKey.c_str());
  
  // Delete all points for this slot
  for (int i = 0; i < MAX_POINTS; i++) {
    String tKey = "t" + String(slotIndex) + "_" + String(i);
    String yKey = "y" + String(slotIndex) + "_" + String(i);
    
    prefs.remove(tKey.c_str());
    prefs.remove(yKey.c_str());
  }
  
  prefs.end();
  
  Serial.println("DELETED");
}

void clearAllProfiles() {
  prefs.begin("profiles", false);
  prefs.clear();
  prefs.end();
  
  Serial.println("CLEARED_ALL");
}

// =====================================================
// ================= CORE FUNCTIONS =====================
// =====================================================

float readThermocoupleC() {
  float t = thermocouple.readCelsius();
  
  if (isnan(t)) {
    if (runActive) {
      stopRun();
      Serial.println("ERROR,thermocouple_fail");
    }
    return currentTempC;
  }
  
  return t;
}

void sortProfileByTime() {
  for (int i = 0; i < currentProfile.pointCount - 1; i++) {
    for (int j = i + 1; j < currentProfile.pointCount; j++) {
      if (currentProfile.points[j].timeSec < currentProfile.points[i].timeSec) {
        ProfilePoint temp = currentProfile.points[i];
        currentProfile.points[i] = currentProfile.points[j];
        currentProfile.points[j] = temp;
      }
    }
  }
}

float getProfileDurationSec() {
  if (currentProfile.pointCount <= 0) return 0.0f;
  return currentProfile.points[currentProfile.pointCount - 1].timeSec;
}

float getTargetTempAtTime(float elapsedSec) {
  if (currentProfile.pointCount <= 0) return 0.0f;

  if (elapsedSec <= currentProfile.points[0].timeSec) 
    return currentProfile.points[0].tempC;
  if (elapsedSec >= currentProfile.points[currentProfile.pointCount - 1].timeSec) 
    return currentProfile.points[currentProfile.pointCount - 1].tempC;

  for (int i = 0; i < currentProfile.pointCount - 1; i++) {
    float t0 = currentProfile.points[i].timeSec;
    float t1 = currentProfile.points[i + 1].timeSec;

    if (elapsedSec >= t0 && elapsedSec <= t1) {
      float frac = (elapsedSec - t0) / (t1 - t0);
      return currentProfile.points[i].tempC + 
             frac * (currentProfile.points[i + 1].tempC - currentProfile.points[i].tempC);
    }
  }

  return currentProfile.points[currentProfile.pointCount - 1].tempC;
}

float computeDutyPercent(float currentTemp, float targetTemp) {
  float error = targetTemp - currentTemp;

  if (error <= -0.3f) return 0.0f;
  if (error >= ctrlSettings.pidBandC) return 100.0f;
  if (error <= 0.0f) return ctrlSettings.minDutyPercent;

  float frac = error / ctrlSettings.pidBandC;
  return ctrlSettings.minDutyPercent + frac * (100.0f - ctrlSettings.minDutyPercent);
}

void applySSRWindow(float dutyPercent) {
  unsigned long now = millis();
  unsigned long windowMs = (unsigned long)(ctrlSettings.controlWindowSec * 1000.0f);
  
  // Minimum window safety to prevent flickering
  if (windowMs < 200) windowMs = 200;

  if (now - windowStartMs >= windowMs) windowStartMs = now;

  unsigned long onTimeMs = windowMs * (dutyPercent / 100.0f);
  bool on = (now - windowStartMs) < onTimeMs;

  ssrState = on;
  digitalWrite(SSR_PIN, on ? HIGH : LOW);
}

void stopRun() {
  runActive = false;
  currentDutyPercent = 0.0f;
  digitalWrite(SSR_PIN, LOW);
  ssrState = false;
}

void startRun() {
  if (!profileLoaded || currentProfile.pointCount <= 0) {
    Serial.println("ERROR,no_profile");
    return;
  }
  runActive = true;
  runStartMs = millis();
  windowStartMs = millis();
  Serial.println("RUN_START");
}

// =====================================================
// ================= SERIAL =============================
// =====================================================

void sendTelemetry() {
  float elapsedSec = runActive ? ((millis() - runStartMs) / 1000.0f) : 0;

  Serial.print("TELEMETRY,");
  Serial.print(millis()); Serial.print(",");
  Serial.print(runActive ? 1 : 0); Serial.print(",");
  Serial.print(currentProfile.name); Serial.print(",");
  Serial.print(elapsedSec, 1); Serial.print(",");
  Serial.print(getProfileDurationSec(), 1); Serial.print(",");
  Serial.print(currentTempC, 2); Serial.print(",");
  Serial.print(targetTempC, 2); Serial.print(",");
  Serial.print(currentDutyPercent, 1); Serial.print(",");
  Serial.println(ssrState ? 1 : 0);
}

void sendCurrentProfile() {
  Serial.print("PROFILE,");
  Serial.print(currentProfile.name);
  Serial.print(",");
  Serial.print(currentProfile.pointCount);

  for (int i = 0; i < currentProfile.pointCount; i++) {
    Serial.print(",");
    Serial.print(currentProfile.points[i].timeSec, 1);
    Serial.print(",");
    Serial.print(currentProfile.points[i].tempC, 2);
  }

  Serial.println();
}

void sendSettings() {
  Serial.print("SETTINGS,");
  Serial.print(ctrlSettings.pidBandC, 2); Serial.print(",");
  Serial.print(ctrlSettings.minDutyPercent, 1); Serial.print(",");
  Serial.println(ctrlSettings.controlWindowSec, 2);
}

// =====================================================
// ================= COMMANDS ===========================
// =====================================================

bool parseProfileCommand(String line) {
  // Format: PROFILE,name,count,time1,temp1,time2,temp2,...
  int firstComma = line.indexOf(',');
  String payload = line.substring(firstComma + 1);

  int comma1 = payload.indexOf(',');
  int comma2 = payload.indexOf(',', comma1 + 1);

  String nameStr = payload.substring(0, comma1);
  int count = payload.substring(comma1 + 1, comma2).toInt();

  if (count <= 0 || count > MAX_POINTS) {
    Serial.println("ERROR,invalid_count");
    return false;
  }

  // Initialize profile
  currentProfile.pointCount = 0;
  nameStr.toCharArray(currentProfile.name, PROFILE_NAME_LEN);

  String rest = payload.substring(comma2 + 1);

  for (int i = 0; i < count; i++) {
    int c1 = rest.indexOf(',');
    if (c1 < 0) break;
    
    String t = rest.substring(0, c1);
    rest = rest.substring(c1 + 1);

    int c2 = rest.indexOf(',');
    String y = (c2 < 0) ? rest : rest.substring(0, c2);
    rest = (c2 < 0) ? "" : rest.substring(c2 + 1);

    currentProfile.points[i].timeSec = t.toFloat();
    currentProfile.points[i].tempC = y.toFloat();
    currentProfile.pointCount++;
  }

  sortProfileByTime();
profileLoaded = true;


// Also store as last used
prefs.begin("curing", false);
prefs.putInt("lastSlot", 0);
prefs.end();

sendCurrentProfile();
return true;
}

bool parseSettingsCommand(String line) {
  // Format: SETTINGS,pidBand,minDuty,ctrlWindow
  int firstComma = line.indexOf(',');
  String payload = line.substring(firstComma + 1);

  int comma1 = payload.indexOf(',');
  int comma2 = payload.indexOf(',', comma1 + 1);

  String pidStr = payload.substring(0, comma1);
  String dutyStr = payload.substring(comma1 + 1, comma2);
  String windowStr = payload.substring(comma2 + 1);

  ctrlSettings.pidBandC = pidStr.toFloat();
  ctrlSettings.minDutyPercent = dutyStr.toFloat();
  ctrlSettings.controlWindowSec = windowStr.toFloat();

  // Validate
  if (ctrlSettings.pidBandC <= 0 || ctrlSettings.minDutyPercent < 0 || 
      ctrlSettings.minDutyPercent > 100 || ctrlSettings.controlWindowSec <= 0) {
    Serial.println("ERROR,invalid_settings");
    return false;
  }

  saveSettingsToFlash();
  sendSettings();
  return true;
}

void handleCommand(String line) {
  line.replace("\r", "");
line.replace("\n", "");
line.trim();

  if (line == "START") {
    startRun();
  }
  else if (line == "STOP") {
    stopRun();
    Serial.println("RUN_STOP");
  }
  else if (line == "GET_PROFILE") {
    sendCurrentProfile();
  }
  else if (line == "GET_SETTINGS") {
    sendSettings();
  }
  else if (line == "GET_STATUS") {
  Serial.print("STATUS,");
  Serial.print(runActive ? 1 : 0); Serial.print(",");
  Serial.print(currentProfile.name); Serial.print(",");
  Serial.print(runActive ? (millis() - runStartMs) / 1000.0f : 0, 1); Serial.print(",");
  Serial.print(getProfileDurationSec(), 1); Serial.print(",");
  Serial.print(currentTempC, 2); Serial.print(",");
  Serial.print(targetTempC, 2); Serial.print(",");
  Serial.print(currentDutyPercent, 1); Serial.print(",");
  Serial.println(ssrState ? 1 : 0);
}
  else if (line == "LIST_PROFILES") {
    listProfilesInFlash();
  }
  else if (line.startsWith("PROFILE,")) {

  if (parseProfileCommand(line)) {

    // Small delay to allow serial buffer to clear
    pendingSave = true;
saveTriggerTime = millis();
  }
}
  else if (line.startsWith("SETTINGS,")) {
    parseSettingsCommand(line);
  }
  else if (line.startsWith("SAVE,")) {
    int slotStr = line.substring(5).toInt();
    saveCurrentProfileToFlash(slotStr);
  }
  else if (line.startsWith("LOAD,")) {
    int slotStr = line.substring(5).toInt();
    loadProfileFromFlash(slotStr);
  }
  else if (line.startsWith("DELETE,")) {
    int slotStr = line.substring(7).toInt();
    deleteProfileFromFlash(slotStr);
  }
  else if (line == "CLEAR_ALL") {
    clearAllProfiles();
  }
  else if (line == "PING") {
  Serial.println("PONG");
}
  else {
    Serial.println("ERROR,unknown_command");
  }
}

// =====================================================
// ================= SETUP ==============================
// =====================================================

void setup() {
  pinMode(SSR_PIN, OUTPUT);
  digitalWrite(SSR_PIN, LOW);

  Serial.begin(SERIAL_BAUD);
  delay(500);

  initFlashStorage();
  
  // Auto-load last used profile (or slot 0 if none)
  prefs.begin("curing", true);
  int lastSlot = prefs.getInt("lastSlot", 0);
  prefs.end();
  
  loadProfileFromFlash(lastSlot);

if (!profileLoaded) {
  Serial.println("INFO,no_profile_loaded");
}

  Serial.println("READY");
  sendSettings();
}

// =====================================================
// ================= LOOP ===============================
// =====================================================

void loop() {
  // Handle serial input
  while (Serial.available()) {
  char c = Serial.read();

  if (c == '\r') continue;

  if (c == '\n') {
    rxLine.replace("\r", "");
    rxLine.trim();

    if (rxLine.length() > 0) {
      handleCommand(rxLine);
    }

    rxLine = "";
  } else {
    if (isPrintable(c)) {
      rxLine += c;
    }
  }
}

  // Read temperature every 500ms
  if (millis() - lastTempReadMs > 500) {
    lastTempReadMs = millis();
    currentTempC = readThermocoupleC();
  }

  // Update control loop when running
  if (runActive) {
    float elapsedSec = (millis() - runStartMs) / 1000.0f;
    
    // Check if run is complete
    if (elapsedSec >= getProfileDurationSec()) {
      stopRun();
    } else {
      targetTempC = getTargetTempAtTime(elapsedSec);
      currentDutyPercent = computeDutyPercent(currentTempC, targetTempC);
      applySSRWindow(currentDutyPercent);
    }
  }

  if (millis() - lastTelemetryMs > 1000) {
  lastTelemetryMs = millis();
  sendTelemetry();
}
// Non-blocking save
if (pendingSave && millis() - saveTriggerTime > 200) {
  pendingSave = false;

  saveCurrentProfileToFlash(0);

  prefs.begin("curing", false);
  prefs.putInt("lastSlot", 0);
  prefs.end();
}
}
